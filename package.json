{
  "name": "vlezet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx apps/share-api/src/server.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "build:android": "vite build --config apps/web/vite.config.ts --mode android",
    "android:sync": "npm run build:android && cap sync android"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "8.0.3",
    "@fastify/rate-limit": "11.2.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-sqlite3": "13.2.0",
    "dexie": "4.4.7",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "license": "MIT"
}
